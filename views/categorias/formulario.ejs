<%- include('../partials/header') %>

<div class="form-container fade-in">
    <h1 class="page-title" style="margin-bottom: 2rem;"><%= titulo %></h1>

    <form action="<%= accion %>" method="POST">
        <div class="form-group">
            <label class="form-label">Nombre de la Categoría</label>
            <input type="text" name="Nombre" required class="form-input" placeholder="Ej: Insecticidades" value="<%= categoria ? categoria.Nombre : '' %>">
        </div>
        
        <div class="form-group">
            <label class="form-label">Descripción</label>
            <textarea name="Descripcion" rows="3" required class="form-input" placeholder="Describe brevemente esta categoría..."><%= categoria ? categoria.Descripcion : '' %></textarea>
        </div>

        <div style="margin-top: 2rem;">
            <button type="submit" class="btn btn-success" style="width: 100%;">Guardar Categoría</button>
            <a href="/categorias" class="text-center mt-4" style="display: block; color: #64748b; text-decoration: none; margin-top: 1rem;">Cancelar</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>