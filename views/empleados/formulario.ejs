<%- include('../partials/header') %>

<div class="form-container fade-in">
    <h1 class="page-title" style="margin-bottom: 2rem;"><%= titulo %></h1>

    <form action="<%= accion %>" method="POST">
        <div class="grid-cols-2">
            <div class="form-group">
                <label class="form-label">Nivel Académico</label>
                <select name="Nivel_Academico" required class="form-input">
                    <option value="Bachillerato" <%= (empleado && empleado.Nivel_Academico === 'Bachillerato') ? 'selected' : '' %>>Bachillerato</option>
                    <option value="Superior" <%= (empleado && empleado.Nivel_Academico === 'Superior') ? 'selected' : '' %>>Superior</option>
                </select>
            </div>
            <div class="form-group">
                <!-- Espacio vacío para mantener el grid o puedes poner otro campo aquí -->
            </div>
        </div>

        <div class="grid-cols-2">
            <div class="form-group">
                <label class="form-label">Nombre</label>
                <input type="text" name="Nombre" required class="form-input" value="<%= empleado ? empleado.Nombre : '' %>">
            </div>
            <div class="form-group">
                <label class="form-label">Apellido</label>
                <input type="text" name="Apellido" required class="form-input" value="<%= empleado ? empleado.Apellido : '' %>">
            </div>
        </div>

        <div class="grid-cols-2">
            <div class="form-group">
                <label class="form-label">DUI</label>
                <input type="text" name="Dui" required class="form-input" placeholder="00000000-0" pattern="[0-9]{8}-[0-9]{1}" title="Formato: 00000000-0" value="<%= empleado ? empleado.Dui : '' %>">
            </div>
            <div class="form-group">
                <label class="form-label">Teléfono</label>
                <input type="text" name="Telefono" required class="form-input" placeholder="0000-0000" pattern="[267][0-9]{3}-[0-9]{4}" title="Formato: 0000-0000 (Debe iniciar con 2, 6 o 7)" value="<%= empleado ? empleado.Telefono : '' %>">
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Sueldo ($)</label>
            <input type="number" step="0.01" min="0.01" name="Sueldo" required class="form-input" value="<%= empleado ? empleado.Sueldo : '' %>">
        </div>

        <div style="margin-top: 2rem;">
            <button type="submit" class="btn btn-success" style="width: 100%;">Guardar Empleado</button>
            <a href="/empleados" class="text-center mt-4" style="display: block; color: #64748b; text-decoration: none; margin-top: 1rem;">Cancelar</a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>