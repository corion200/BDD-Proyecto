<%- include('../partials/header') %>

<div class="form-container fade-in">
    <h1 class="page-title" style="margin-bottom: 2rem; border-bottom: 2px solid #e2e8f0; padding-bottom: 1rem;"><%= titulo %></h1>

    <form action="<%= accion %>" method="POST">
        <div class="form-group">
            <label class="form-label">Nombre del Producto</label>
            <input type="text" name="Nombre" placeholder="Ej: Fortamilk 500g" required class="form-input" value="<%= producto ? producto.Nombre : '' %>">
        </div>
        
        <div class="grid-cols-2">
            <div class="form-group">
                <label class="form-label">Precio Unitario ($)</label>
                <input type="number" step="0.01" min="0.01" name="Precio_Uni" required class="form-input" placeholder="0.00" value="<%= producto ? producto.Precio_Uni : '' %>">
            </div>
            
            <div class="form-group">
                <label class="form-label">Stock Inicial</label>
                <input type="number" min="0" name="Stock" required class="form-input" placeholder="0" value="<%= producto ? producto.Stock : '' %>">
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Fecha de Vencimiento</label>
            <input type="date" name="Fecha_Vencimiento" required class="form-input" value="<%= producto ? new Date(producto.Fecha_Vencimiento).toISOString().split('T')[0] : '' %>">
        </div>

        <div style="margin-top: 2.5rem;">
            <button type="submit" class="btn btn-success" style="width: 100%; padding: 1rem; font-size: 1rem;">
                Guardar Producto
            </button>
            <a href="/productos" class="text-center mt-4" style="display: block; color: #64748b; text-decoration: none; margin-top: 1rem; font-weight: 500;">
                ← Cancelar y Volver
            </a>
        </div>
    </form>
</div>

<%- include('../partials/footer') %>